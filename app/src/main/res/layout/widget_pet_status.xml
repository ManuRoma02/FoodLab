<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pet_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="7dp">

    <!-- Top / Hero Section: Stats + Mascot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.85"
        android:background="@drawable/widget_mascot_halo_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="7dp"
        android:paddingVertical="3dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.58"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pet_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text=""
                android:textAllCaps="true"
                android:textColor="#FF453A"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pet_hp_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="1850"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pet_target_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="su 2500 kcal"
                android:textColor="#8E8E93"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/pet_image"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="0.42"
            android:contentDescription="@string/widget_mascot_status"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/foodlab_mascot_duo" />
    </LinearLayout>

    <!-- Bottom Macro Pills: Proteine, Carboidrati, Grassi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="0.75"
        android:orientation="horizontal">

        <!-- Protein Pill -->
        <TextView
            android:id="@+id/protein_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_macro_protein_bg"
            android:contentDescription="@string/widget_protein_placeholder"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="145g"
            android:textColor="#30D158"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Carbs Pill -->
        <TextView
            android:id="@+id/carbs_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_macro_carbs_bg"
            android:contentDescription="@string/widget_carbs_placeholder"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="210g"
            android:textColor="#FFD60A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Fat Pill -->
        <TextView
            android:id="@+id/fat_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_macro_fat_bg"
            android:contentDescription="@string/widget_fat_placeholder"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="68g"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
