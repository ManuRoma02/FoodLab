<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pedometer_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/retro_widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_steps_title"
        android:textColor="#00DDFF"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        android:textStyle="bold" />

    <RelativeLayout
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="8dp">

        <ProgressBar
            android:id="@+id/steps_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:progressDrawable="@drawable/circular_progress_widget"
            android:max="10000"
            android:progress="0" />

        <TextView
            android:id="@+id/steps_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/widget_value_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold" />
    </RelativeLayout>
    
    <ImageView
        android:id="@+id/widget_refresh"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        android:src="@android:drawable/ic_popup_sync"
        android:contentDescription="@string/widget_refresh_steps"
        android:tint="#888888"
        android:background="?android:attr/selectableItemBackgroundBorderless"/>

</LinearLayout>

